# Connection string for the disposable local Postgres started by
# `npm run db:test:up` (docker-compose.test.yml). Safe to commit, unlike
# .env/.env.local -- this only ever points at a throwaway local container
# with a hardcoded, non-secret password, never a real database.
#
# Used by `npm run test:db` (DB-backed *.db.test.ts files) -- plain
# npm run test (pure/unit tests) never reads this file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/campusconnect_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/campusconnect_test
