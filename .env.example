# Postgres (Supabase provides both a pooled and direct connection string)
# DATABASE_URL: transaction pooler, port 6543 — MUST include ?pgbouncer=true
#   or Prisma's prepared statements collide across pooled connections
#   ("prepared statement already exists", error 42P05). Also pins
#   connection_limit and pool_timeout explicitly -- Prisma's own default
#   connection_limit (num_physical_cpus * 2 + 1) is computed per-machine, so
#   a bigger box (e.g. a Vercel serverless function's host) would otherwise
#   silently ask for more connections than a small Supabase compute tier
#   (nano/micro) can actually give it, especially multiplied across several
#   concurrent serverless invocations. 5 is a conservative fixed cap that
#   still leaves headroom under the project's own max_connections; raise it
#   only alongside a real compute tier upgrade, never as a first response to
#   a "pool exhausted" error.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10
# DIRECT_URL: used only for migrations. Supabase's plain db.<project-ref>.supabase.co
#   host resolves IPv6-only, which fails in IPv4-only environments (P1001 "Can't
#   reach database server"). Use the session pooler instead — same host as
#   DATABASE_URL, port 5432, no pgbouncer flag:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=

# Supabase Auth / Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email: university verification, parent invites)
RESEND_API_KEY=
EMAIL_FROM=
