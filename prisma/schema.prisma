// CampusConnect database schema.
// Mirrors the approved architecture plan at C:\Users\sahil\.claude\plans\i-am-building-a-wise-sutton.md
// Do not "simplify" the nullable Request.tripId, the composable VerificationRecord.type,
// the StudentRecord/ParentStudentLink duplicate-prevention pattern, or the
// three-state ParentStudentLinkStatus (otp_verified/approved/revoked, which
// deliberately revises an earlier "no capability until approved" decision —
// see the security note on ParentStudentLink) — each encodes a resolved
// product decision.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VerificationType {
  email
  university
  parent_relationship
  identity
}

enum VerificationStatus {
  pending
  verified
  revoked
}

enum ParentStudentInviteStatus {
  pending
  accepted
  expired
  revoked
}

// otp_verified: the parent proved access to the student's university inbox
// via OTP -- they can already act (post on the student's behalf), but the
// student has not confirmed anything yet. approved: the actual student
// explicitly confirmed the relationship (either because they initiated the
// invite themselves, or because they later reviewed and confirmed an
// OTP-established link). revoked: either side severed it, or the student
// used the no-account-required objection link. See ParentStudentLink for
// the full security rationale.
enum ParentStudentLinkStatus {
  otp_verified
  approved
  revoked
}

enum RequestType {
  ride
  package
}

enum RequestStatus {
  pending
  accepted
  declined
  completed
  cancelled
}

// Renamed from an earlier `active` (see git history) to match the product's
// own three-stage vocabulary exactly -- a Postgres enum value rename
// (`ALTER TYPE ... RENAME VALUE`) is a metadata-only change, so existing
// rows carried the new label automatically with no data rewrite.
enum TripStatus {
  upcoming
  completed
  cancelled
}

enum ReportStatus {
  open
  under_review
  resolved
  dismissed
}

// Kept intentionally narrow to the events already wired up (see
// src/lib/notifications.ts) -- add a case here only once something actually
// creates that kind of notification, not speculatively.
enum NotificationType {
  connection_request
  connection_accepted
  connection_declined
  new_message
  // Sent to the requester of a ConnectionRequest (pending or accepted) when
  // the trip owner cancels the trip out from under it -- see the Trip
  // Management section of CLAUDE.md and DELETE /api/trips/[id].
  trip_cancelled
}

model User {
  // Matches Supabase Auth's auth.users.id exactly — set explicitly by app
  // code in the auth callback (src/app/auth/callback/route.ts), never
  // generated here. One User row per Supabase Auth account.
  id               String   @id
  email            String   @unique
  name             String
  photoUrl         String?
  // Free-text, unused by the profile feature -- university affiliation is
  // always derived from the verified StudentRecord/VerificationRecord
  // instead, never from this field. Left in place only in case a future
  // alumni-onboarding feature wants a self-declared (unverified) school
  // name; do not wire it into any "university" display in the meantime.
  collegeName      String?
  // Superseded by homeCityId below -- kept only because it's not worth a
  // migration to drop an already-unpopulated column. Do not read or write
  // this in new code.
  homeRegionId     String?
  homeRegion       Region?  @relation(fields: [homeRegionId], references: [id])
  // The profile/onboarding feature's home-area field. City-level (not just
  // Region-level) so it lines up with how Trip/Request already key
  // origin/destination off City -- a "general home area" for display is
  // just city.name, and it doubles as an input to future trip-matching that
  // Region-level granularity couldn't support.
  homeCityId       String?
  homeCity         City?    @relation("UserHomeCity", fields: [homeCityId], references: [id])
  // Set once the post-signup onboarding form (student: /onboarding, parent:
  // step 0 of /family/connect-student) is submitted. An explicit timestamp
  // rather than inferring completion from homeCityId being non-null, so the
  // signal stays stable even if home-area later becomes editable-to-blank.
  onboardingCompletedAt DateTime?
  // Student-only onboarding fields below -- all optional, free text (not
  // enums), and all public (same visibility tier as name/photo/university).
  // "year" is deliberately a free string, not a class-year enum, so a
  // student can write "Junior" or "2027" or whatever reads naturally to
  // them; over-structuring this wasn't worth it for what's a display field.
  major             String?
  year              String?
  travelPreferences String?
  // Multi-select against LOOKING_FOR_OPTIONS (src/lib/lookingFor.ts) --
  // reuses the Post page's own vocabulary (Offer a Ride / Need a Ride /
  // Offer Package Space / Need Delivery) rather than inventing new
  // categories. A stated interest, not a capability grant -- doesn't gate
  // anything, purely descriptive on the profile.
  lookingFor        String[] @default([])
  // Parent-only onboarding field. Private -- same visibility tier as email,
  // never surfaced on the public profile (see src/lib/profile.ts).
  phone             String?
  // Parent-only, free text, self-declared by the parent (NOT derived from
  // StudentRecord.fullName -- that stays private, shown only to the parent
  // themselves on their own /profile). Public, so another user browsing a
  // parent's profile can see who they're posting on behalf of. Cleared
  // whenever the parent's last non-revoked ParentStudentLink is removed
  // (see src/app/api/family/link-objection/[token]/reject/route.ts) --
  // the student's own objection/revoke is the safety valve for a parent
  // publicly naming them without consent.
  linkedStudentName String?
  // A factual record of onboarding path, NOT a permanent role -- doesn't
  // restrict what this account can do (still USER != ROLE: a parent can
  // request rides for themselves, offer package space, etc. exactly like
  // anyone else). Its only purpose is deciding whether the
  // "must link a student before using the app" gate applies (see
  // hasLinkedStudent() in src/lib/auth.ts and the check in
  // src/app/layout.tsx) -- set once at creation via
  // src/app/api/auth/parent-signup, never changed afterward.
  signedUpAsParent Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  verifications            VerificationRecord[]
  tripsAsTraveler          Trip[]                    @relation("TripTraveler")
  requestsPosted           Request[]                 @relation("RequestPostedBy")
  requestsBeneficiary      Request[]                 @relation("RequestBeneficiary")
  // A User's own StudentRecord, if they signed up (or later claimed) with a
  // supported university email. Nullable -- parents/alumni/travelers never
  // have one. The reverse of StudentRecord.userId.
  studentRecord            StudentRecord?
  parentLinksAsParent      ParentStudentLink[]       @relation("LinkParent")
  parentStudentOtpRequests ParentStudentOtpRequest[]
  invitesSent              ParentStudentInvite[]     @relation("InviteStudent")
  conversationsIn          ConversationParticipant[]
  messagesSent             Message[]                 @relation("MessageSender")
  connectionRequestsSent     ConnectionRequest[]     @relation("ConnectionRequestRequester")
  connectionRequestsReceived ConnectionRequest[]     @relation("ConnectionRequestRecipient")
  reviewsGiven             Review[]                  @relation("ReviewReviewer")
  reviewsReceived          Review[]                  @relation("ReviewReviewee")
  reportsFiled             Report[]                  @relation("ReportReporter")
  reportsAgainst           Report[]                  @relation("ReportReported")
  blocksInitiated          Block[]                   @relation("BlockBlocker")
  blocksReceived           Block[]                   @relation("BlockBlocked")
  notifications            Notification[]

  @@index([homeRegionId])
  @@index([homeCityId])
}

// One row per independent verification fact. Deliberately not a single boolean/enum
// on User — badges must be able to exist independently, and a future `identity`
// (government ID) type must slot in without a migration.
model VerificationRecord {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id])
  type           VerificationType
  status         VerificationStatus @default(pending)
  verifiedValue  String?
  metadata       Json?
  token          String?            @unique
  tokenExpiresAt DateTime?
  verifiedAt     DateTime?
  createdAt      DateTime           @default(now())

  // One record per verification type per user — a re-request updates this
  // row in place (new token, status reset to pending) rather than piling up
  // duplicates.
  @@unique([userId, type])
}

model SupportedUniversityDomain {
  id             String @id @default(uuid())
  domain         String @unique
  universityName String
  regionId       String
  region         Region @relation(fields: [regionId], references: [id])

  studentRecords StudentRecord[]
  otpRequests    ParentStudentOtpRequest[]
}

// A student, identified by a university email, that can exist independently
// of a CampusConnect User account -- this is what lets a parent be the first
// person to use the product for a given student (see ParentStudentLink).
// universityEmail is the SOLE duplicate-prevention mechanism: every creation
// path (a parent's OTP-confirm, or a student's own signup) MUST go through a
// real atomic upsert keyed on this field -- never a separate find-then-create,
// which races under concurrent requests. Claiming (attaching userId) is a
// second, different race: it must be a conditional update
// (WHERE userId IS NULL) checking affected-row-count, not just relying on
// the @unique on userId, which only stops one User claiming two records.
model StudentRecord {
  id                        String                    @id @default(uuid())
  fullName                  String
  // Normalized: lowercased + trimmed only. Do NOT apply Gmail-style
  // dot-stripping or +alias collapsing -- that's a Gmail-specific quirk that
  // would be actively wrong for arbitrary university mail systems.
  universityEmail           String                    @unique
  universityDomainId        String
  universityDomain          SupportedUniversityDomain @relation(fields: [universityDomainId], references: [id])
  // Source of truth for "is this .edu email proven reachable" -- set either
  // when a parent's OTP confirms, or when the student verifies it themselves
  // via their own signup. The User-facing VerificationRecord(type=university)
  // badge is a synced cache of this fact, not the other way around.
  universityEmailVerifiedAt DateTime?
  // Null = unclaimed (a parent created this before the student ever signed
  // up). Set once a student claims it -- either by signing up directly with
  // this exact email, or by an explicit later claim action.
  userId                    String?                   @unique
  user                      User?                     @relation(fields: [userId], references: [id])
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  parentLinks ParentStudentLink[]

  @@index([universityDomainId])
}

// Ephemeral pending state for a parent proving access to a student's
// university inbox -- deliberately NOT stored on StudentRecord, because a
// StudentRecord should only ever be created at successful-OTP-confirm time,
// not speculatively when a parent merely types an email (typos would
// otherwise accumulate as junk unclaimed records). Deleted once consumed.
//
// Cannot reuse Supabase's own OTP system here: Supabase's OTP is inherently
// tied to the auth account being signed into/created for that email, and
// this is a parent proving access to a THIRD PARTY's inbox, not their own --
// so this reuses the custom token/email/confirm pattern already built for
// src/app/api/verification/university/{request,confirm}/route.ts, just with
// a short numeric code (more brute-forceable than a 32-byte hex token, hence
// the hash + expiry + attempt cap) instead of a link.
model ParentStudentOtpRequest {
  id                 String                    @id @default(uuid())
  parentId           String
  parent             User                      @relation(fields: [parentId], references: [id])
  studentEmail       String // normalized; NOT unique -- a parent may retry a corrected email
  universityDomainId String
  universityDomain   SupportedUniversityDomain @relation(fields: [universityDomainId], references: [id])
  otpCodeHash        String // hashed (sha256) -- unlike the long hex tokens elsewhere, an 8-digit code is guessable without this
  otpExpiresAt       DateTime
  attemptCount       Int                       @default(0)
  createdAt          DateTime                  @default(now())

  @@index([parentId])
}

// The only path to a parent account existing: a student-initiated invite.
model ParentStudentInvite {
  id          String                    @id @default(uuid())
  studentId   String
  student     User                      @relation("InviteStudent", fields: [studentId], references: [id])
  parentEmail String
  token       String                    @unique
  status      ParentStudentInviteStatus @default(pending)
  expiresAt   DateTime
  createdAt   DateTime                  @default(now())

  @@index([studentId])
}

// Points at a StudentRecord, not a User directly -- this is what lets the
// link exist before the student ever has a CampusConnect account, and means
// existing links stay valid automatically once the student later claims the
// record (no relinking needed at claim time).
//
// SECURITY NOTE (revises an earlier decision -- see plan doc): OTP
// possession alone (otp_verified) already lets the parent post "for" the
// student, rather than blocking until a further approval. This was a
// deliberate tradeoff, not an oversight: walking through every parent
// capability in the spec, none of them expose private student data at
// otp_verified -- creating own trips/requests needs no link at all, and
// "view information explicitly shared with them" is self-gating (nothing
// exists to share until an account-holding student opts in). The only
// capability actually gated by link status is posting a PUBLIC "for my
// student" request using data the parent themselves typed in -- so the real
// risk at otp_verified is reputational/representation harm (an unwanted
// parent publicly claiming a connection), not data disclosure. That's also
// why an OTP alone can't fully prove the real student consented -- the code
// only proves whoever typed it could read that inbox at that moment, which
// could mean the parent has direct (possibly unwanted) access, or the
// student cooperatively relayed it out-of-band; the product can't tell
// these apart. Mitigations, all required together, not optional:
//   1. Any Request posted while status=otp_verified renders publicly marked
//      "connection not yet confirmed by student" to every other viewer.
//   2. The student notice email (sent at otp_verified, distinct from the
//      OTP email) includes objectionToken below -- a one-click,
//      no-account-required revoke, so the student doesn't have to ever sign
//      up to shut this down.
//   3. The parent must be an authenticated User to start this flow (their
//      OWN email confirmation is deliberately NOT required, per product
//      decision -- see src/app/api/auth/parent-signup -- so this is a
//      weaker accountability signal than originally designed; mitigations
//      1 and 2 above carry correspondingly more weight as a result).
model ParentStudentLink {
  id              String                  @id @default(uuid())
  parentId        String
  parent          User                    @relation("LinkParent", fields: [parentId], references: [id])
  studentRecordId String
  studentRecord   StudentRecord           @relation(fields: [studentRecordId], references: [id])
  status          ParentStudentLinkStatus @default(otp_verified)
  // objectionToken powers the no-account-required "this wasn't me" link in
  // the student notice email. Landing on it shows a confirmation page
  // requiring an explicit button click (POST) before revoking -- NEVER
  // auto-revoke on the GET/page-load itself, since email security scanners
  // commonly pre-fetch links (confirmed firsthand this session: Supabase's
  // own confirmation link got silently consumed by exactly this before the
  // real user could click it -- an auto-acting GET here would let a scanner
  // falsely revoke a legitimate connection).
  objectionToken  String?                 @unique
  otpVerifiedAt   DateTime?
  approvedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime                @default(now())

  @@unique([parentId, studentRecordId])
  @@index([studentRecordId])
}

model Region {
  id   String @id @default(uuid())
  name String @unique // "Bay Area", "UC Irvine Area"
  slug String @unique

  cities    City[]
  users     User[]
  domains   SupportedUniversityDomain[]
  routesAsA RouteCommunity[]            @relation("RouteRegionA")
  routesAsB RouteCommunity[]            @relation("RouteRegionB")
}

// Cities are open-ended, not a closed Bay-Area-only allowlist — a student can
// post a trip against any city (e.g. an LAX airport entry outside every
// seeded region). Pre-seed common ones; support adding more on demand.
model City {
  id       String @id @default(uuid())
  name     String
  regionId String
  region   Region @relation(fields: [regionId], references: [id])

  tripsAsOrigin         Trip[]    @relation("TripOrigin")
  tripsAsDestination    Trip[]    @relation("TripDestination")
  requestsAsOrigin      Request[] @relation("RequestOrigin")
  requestsAsDestination Request[] @relation("RequestDestination")
  usersAsHomeCity       User[]    @relation("UserHomeCity")

  @@unique([name, regionId])
}

// A RouteCommunity being `active` controls what Home *features* by default
// (Bay Area <-> UCI at launch). It does NOT gate what Trip/Request can be
// created against — that's determined purely by City selection.
model RouteCommunity {
  id        String  @id @default(uuid())
  regionAId String
  regionA   Region  @relation("RouteRegionA", fields: [regionAId], references: [id])
  regionBId String
  regionB   Region  @relation("RouteRegionB", fields: [regionBId], references: [id])
  active    Boolean @default(false)

  @@unique([regionAId, regionBId])
}

model Trip {
  id                    String     @id @default(uuid())
  travelerId            String
  traveler              User       @relation("TripTraveler", fields: [travelerId], references: [id])
  // Subject line stating the purpose of the post at a glance (e.g. "Weekend
  // trip home, 2 seats free"). Nullable in the DB only because it postdates
  // this model's earliest rows -- tripFieldsSchema requires it non-empty on
  // every create/edit going forward.
  title                 String?
  originCityId          String
  originCity            City       @relation("TripOrigin", fields: [originCityId], references: [id])
  // Nullable + destinationText below: a poster can pick a listed City OR
  // type a destination that isn't in the seeded list (e.g. an airport, or a
  // town outside the launch regions). Exactly one of the two is required --
  // enforced by tripFieldsSchema's refine, not a DB constraint, consistent
  // with how validation works everywhere else in this project.
  destinationCityId     String?
  destinationCity       City?      @relation("TripDestination", fields: [destinationCityId], references: [id])
  destinationText       String?
  departureDate         DateTime
  departureTime         String?
  // Poster is open to some slack around departureDate/departureTime rather
  // than requiring an exact match -- purely descriptive for now (no
  // matching/search logic reads this yet).
  flexibleTime          Boolean    @default(false)
  seatsTotal            Int        @default(0)
  seatsRemaining        Int        @default(0)
  packageSpaceAvailable Boolean    @default(false)
  packageCapacityNote   String?
  // Free text describing the TRIP (e.g. "driving my own car" vs. "organizing
  // a shared ride") — never a contribution/gas-money/payment field.
  tripNotes             String?
  status                TripStatus @default(upcoming)
  createdAt             DateTime   @default(now())

  requests            Request[]
  conversations       Conversation[]
  connectionRequests  ConnectionRequest[]

  @@index([originCityId, destinationCityId, departureDate])
  @@index([travelerId])
}

enum ConnectionRequestStatus {
  pending
  accepted
  declined
  cancelled
}

// A formal, gated request to connect over a specific Trip -- distinct from
// the ungated "message the traveler" flow (Conversation, see below):
// RegisterInterestForm lets ANY viewer message the traveler immediately
// (the plan doc's "ask before committing to a formal request" design,
// deliberately left alone), while ConnectionRequest adds an explicit
// pending -> accepted/declined/cancelled lifecycle the trip owner controls.
// Accepting one calls the same findOrCreateConversationForTrip
// (src/lib/messaging.ts) that RegisterInterestForm's endpoint uses --
// there is exactly one messaging system, not two; ConnectionRequest only
// gates *when* it unlocks for this flow, it doesn't reimplement it.
model ConnectionRequest {
  id          String                  @id @default(uuid())
  tripId      String
  trip        Trip                    @relation(fields: [tripId], references: [id])
  requesterId String
  requester   User                    @relation("ConnectionRequestRequester", fields: [requesterId], references: [id])
  recipientId String
  recipient   User                    @relation("ConnectionRequestRecipient", fields: [recipientId], references: [id])
  status      ConnectionRequestStatus @default(pending)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  // No DB-level uniqueness on (tripId, requesterId): only a PENDING
  // duplicate is disallowed (enforced in application code, POST
  // /api/connection-requests), and a requester must be able to try again
  // after a decline or their own cancellation -- a blanket unique
  // constraint would block that. A duplicate pending row slipping through
  // a race is the same low-stakes "minor UX nuisance, not a security or
  // data-integrity issue" tradeoff already made for Conversation reuse
  // (see src/lib/messaging.ts) -- not worth a partial unique index for.
  @@index([tripId])
  @@index([requesterId])
  @@index([recipientId])
}

// Unified ride + package request. type discriminates the two; tripId is
// nullable so a "requester posts first" flow (need a ride before any
// matching trip exists) is representable without a second model.
model Request {
  id     String      @id @default(uuid())
  type   RequestType
  tripId String?
  trip   Trip?       @relation(fields: [tripId], references: [id])

  // Only used when tripId is null (standalone request).
  originCityId      String?
  originCity        City?     @relation("RequestOrigin", fields: [originCityId], references: [id])
  // Mirrors Trip.destinationText -- a poster can pick a listed City OR type
  // a destination that isn't in the seeded list. Exactly one of
  // destinationCityId/destinationText is required for a standalone request,
  // enforced by requestFieldsSchema's refine.
  destinationCityId String?
  destinationCity   City?     @relation("RequestDestination", fields: [destinationCityId], references: [id])
  destinationText   String?
  neededDate        DateTime?
  neededTime        String?
  // Mirrors Trip.flexibleTime -- purely descriptive, no matching/search
  // logic reads this yet.
  flexibleTime      Boolean   @default(false)
  // General notes, distinct from packageDescription (package-specific
  // details) -- applies to ride and package requests alike.
  notes             String?

  postedById    String
  postedBy      User   @relation("RequestPostedBy", fields: [postedById], references: [id])
  beneficiaryId String
  beneficiary   User   @relation("RequestBeneficiary", fields: [beneficiaryId], references: [id])

  status RequestStatus @default(pending)

  // ride-specific
  seatsRequested Int?

  // package-specific
  packageDescription String?
  packageSize        String?
  neededByDate       DateTime?

  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  completedAt DateTime?

  conversation Conversation?
  reviews      Review[]

  @@index([postedById])
  @@index([beneficiaryId])
  @@index([tripId])
}

// Scoped to (trip, counterpart) so a prospective requester can ask questions
// before a formal Request exists. requestId is attached once one is created.
model Conversation {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  requestId String?  @unique
  request   Request? @relation(fields: [requestId], references: [id])
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([tripId])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  // Set to now() every time this participant opens /messages/[id] for this
  // conversation (POST /api/conversations/[id]/read). Null means "never
  // opened" -- any message at all counts as unread in that case. Drives the
  // unread bold/badge treatment on /messages and the unread-conversation
  // count badge next to "Messages" in the nav (src/lib/messaging.ts).
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  body           String
  // Reserved for future rich messaging (photos, quick replies, payment
  // requests) — unused in MVP, present now so that's additive, not a migration.
  attachmentUrl  String?
  attachmentType String?
  sentAt         DateTime     @default(now())

  @@index([conversationId, sentAt])
}

// Fraud-resistant by construction: only on a completed Request, only its
// participants, one review per (request, reviewer) pair.
model Review {
  id         String   @id @default(uuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id])
  reviewerId String
  reviewer   User     @relation("ReviewReviewer", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("ReviewReviewee", fields: [revieweeId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([requestId, reviewerId])
  @@index([revieweeId])
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id])
  reportedUserId String
  reportedUser   User         @relation("ReportReported", fields: [reportedUserId], references: [id])
  contextType    String? // "trip" | "request" | "message" | "profile"
  contextId      String?
  reason         String
  detail         String?
  status         ReportStatus @default(open)
  createdAt      DateTime     @default(now())

  @@index([reportedUserId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// One row per in-app notification. Deliberately flat (title/message as
// plain strings written at creation time, not re-derived at read time from
// relatedId) so a notification still reads correctly even if the thing it
// points at later changes -- e.g. a ConnectionRequest's status moving on
// doesn't rewrite history for a notification already shown to the user.
// relatedId is untyped/unvalidated on purpose (it points at whichever
// entity the type implies -- a ConnectionRequest, a Conversation -- never a
// second FK per possible target) and is resolved to a destination URL by
// notificationLink() in src/lib/notifications.ts, the one place that
// mapping lives.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  relatedId String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
